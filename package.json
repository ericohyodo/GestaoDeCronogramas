{
  "name": "gestao-cronogramas",
  "productName": "Gestão de Cronogramas",
  "version": "0.1.0",
  "description": "Aplicativo desktop para gestão de cronogramas",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n next,electron -c blue,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "next dev renderer --port 3123",
    "dev:electron": "wait-on tcp:127.0.0.1:3123 && cross-env ELECTRON_RENDERER_URL=http://localhost:3123 tsup --watch electron --watch contratos --onSuccess \"electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "next build renderer",
    "build:electron": "tsup",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable",
    "typecheck": "tsc -p electron --noEmit && tsc -p renderer --noEmit && tsc -p testes --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.24.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
